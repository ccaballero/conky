# vim: ft=conkyrc

conky.config = {
    background = false,
    update_interval = 2.0,
    double_buffer = true,
    use_xft = true,
    text_alpha = 1.0,
    font = 'Futura:size=9',
    own_window = true,
    own_window_class = 'Conky',
    own_window_color = '#00000000',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    gap_x = 40,
    gap_y = 10,
    alignment = 'top_left',
    minimum_width = 300,
    maximum_width = 300,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    default_color = 'ffffff',
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    out_to_stderr = false,
    uppercase = false,
    use_spacer = 'none',
    lua_load = '~/.conky/widgets.mayuri.1.lua',
    lua_draw_hook_pre = 'widgets'
}

