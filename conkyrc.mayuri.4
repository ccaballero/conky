# vim: ft=conkyrc

conky.config = {
    background = false,
    update_interval = 2.0,
    double_buffer = true,
    use_xft = true,
    text_alpha = 1.0,
    font = 'Futura:size=9',
    own_window = true,
    own_window_class = 'Conky',
    own_window_color = '#00000000',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    gap_x = 758,
    gap_y = 10,
    alignment = 'top_left',
    minimum_width = 300,
    maximum_width = 300,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    default_color = 'ffffff',
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    out_to_stderr = false,
    uppercase = false,
    use_spacer = 'none',
    lua_load = '~/.conky/widgets.mayuri.4.lua',
    lua_draw_hook_post = 'widgets'
}

conky.text = [[
${voffset 10}${alignr 0}${font GeosansLight:size=16}${time %e de %B del %Y}${font}
${alignr 0}${voffset 4}${time %A}


${voffset 48}${font Futura:size=12}SENSORS:${font}
${execpi 2 node ~/.conky/sensors.js }



${voffset -8}${font Futura:size=12}PARTITIONS:${font}
${voffset 4}/
${alignr 180}${voffset -16}${fs_used /}
${alignr 100}${voffset -16}${fs_free /}
${alignr  20}${voffset -16}${fs_used_perc /}%
${voffset 4}/efi
${alignr 180}${voffset -16}${fs_used /efi}
${alignr 100}${voffset -16}${fs_free /efi}
${alignr  20}${voffset -16}${fs_used_perc /efi}%
${voffset 4}windows
${alignr 180}${voffset -16}${fs_used /mnt/windows}
${alignr 100}${voffset -16}${fs_free /mnt/windows}
${alignr  20}${voffset -16}${fs_used_perc /mnt/windows}%


${voffset 8}${font Futura:size=12}AUDIO:${font}
${execpi 2 ~/.conky/audio.sh }
]]
